# Copy to .env.local for local development. `neon deploy` fills in the Neon values automatically.

# ── Neon Postgres (injected by `neon deploy` / `neon env pull`) ──
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Neon Object Storage, bucket "media" (injected by `neon deploy`) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
MEDIA_BUCKET=media

# ── App ──
SITE_URL=https://your-domain.example      # canonical public address
SESSION_SECRET=                           # long random string (openssl rand -base64 32)
RATE_LIMIT_SALT=                          # another random string
CRON_SECRET=                              # Vercel sends this as a Bearer token to /api/cron/cleanup
ALLOW_INDEXING=false                      # set to true ONLY on the real production launch
OWNER_MFA_REQUIRED=true                   # owner tools need two-step sign-in

# ── Optional email notification of new contact notes ──
RESEND_API_KEY=
MAIL_FROM=Scrapbook <notes@your-domain.example>
CONTACT_INBOX=                            # fallback if not set in Owner settings

# ── Local development only ──
# STORAGE_DRIVER=local                    # store photos in ./.storage instead of Neon
